# Settings for bootstrap/github/setup.sh. Copy to settings.env (git-ignored)
# and fill in. Nothing here is secret.

# GitHub repository and who controls it.
GH_ORG=<github-org>
GH_REPO=aws-access-management
GH_VISIBILITY=public                          # public | private (private needs GitHub Team/Enterprise for the gates)
GH_APPROVER=<github-user>                     # the only user who can approve PRs and applies
GH_TEAM=aws-access-management                 # every org member; Write on the repo, so they can open PRs
GH_APPROVER_TEAM=aws-access-management-approvers  # just GH_APPROVER; may merge their own PRs
APPLY_ENVIRONMENT=production

# AWS (management account) and Terraform state.
AWS_REGION=us-east-1
STATE_KEY=permissions/terraform.tfstate       # must match accounts/versions.tf
# STATE_BUCKET=                               # default: bucket_name output of bootstrap/state-bucket
EXECUTION_ROLE_NAME=OrganizationAccountAccessRole
ROLE_NAME_PREFIX=github-aws-access-management # roles <prefix>-plan and <prefix>-apply
TFVARS_FILE=accounts/terraform.tfvars         # stored (base64) as the TFVARS_BASE64 secret
