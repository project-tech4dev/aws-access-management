# Copy to terraform.tfvars and fill in.

region = "us-east-1"

# account_assignments and delegations are in account_assignments.auto.tfvars
# and delegations.auto.tfvars (in CI: the TF_ACCOUNT_ASSIGNMENTS and
# TF_DELEGATIONS repository variables). Don't set them here.

# Role the fan-out script assumes in each account a delegation's permission set
# is assigned to. Must already exist there and be assumable by the credentials
# Terraform runs as.
execution_role_name = "OrganizationAccountAccessRole"


# Platform roles (no boundary) created in every account. The default is the two
# EKS roles above; override to add more. Names must not start with any prefix.
# platform_roles = {
#   platform-eks-cluster = { trust_policy_file = "eks-cluster-trust.json", managed_policies = ["AmazonEKSClusterPolicy"] }
#   platform-eks-node    = { trust_policy_file = "eks-node-trust.json", managed_policies = ["AmazonEKSWorkerNodePolicy", "AmazonEKS_CNI_Policy", "AmazonEC2ContainerRegistryReadOnly"] }
# }

# REQUIRED. GitHub orgs whose Actions workflows may use the GitHub OIDC provider (case-sensitive).
github_orgs = ["<your-github-org>"]

# Optional. AWS accounts outside the org that may assume roles here (vendor
# integrations). All other outside callers are denied sts:AssumeRole by an RCP.
# trusted_external_account_ids = ["111122223333"]

# Optional. Leave unset to use ambient credentials (e.g. running as the
# management account). Set these if Terraform runs from a separate automation
# account that must hop in for the Organizations / Identity Center calls.
# org_role_arn        = "arn:aws:iam::111111111111:role/tf-delegated-iam-org"
# idcaccount_role_arn = "arn:aws:iam::111111111111:role/tf-delegated-iam-idc"
