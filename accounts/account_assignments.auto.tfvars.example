# account_assignments: in CI, the TF_ACCOUNT_ASSIGNMENTS repository variable
# (Settings > Secrets and variables > Actions > Variables). That copy is the one
# that counts; refresh this local file with
#   gh variable get TF_ACCOUNT_ASSIGNMENTS --repo <org>/<repo> > account_assignments.auto.tfvars
# Never commit it: it holds account IDs and group names.
#
# Who gets which permission set where, keyed by any name. An OU covers every
# ACTIVE account beneath it (accounts added later are assigned on the next
# apply). Groups and users must already exist in Identity Center.
#
# Every OU and account a delegation's permission set (here PowerUserAccess) is
# assigned to also gets the delegation policies, platform roles, GitHub OIDC
# provider and RCPs. Never assign those to the management account.
account_assignments = {
  nonprod-poweruser = {
    permission_set = "PowerUserAccess"
    groups         = ["Developers"]
    ous            = ["ou-abcd-11111111"]
  }
  billing-readonly = {
    permission_set = "ReadOnlyAccess"
    groups         = ["Finance"]
    users          = ["jane@example.org"]
    accounts       = ["111122223333"]
  }
}
